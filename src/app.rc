#include <windows.h>

// 应用图标（IDI_ICON1 = 1）
IDI_ICON1 ICON "..\\icon.ico"

// 版本信息
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "FtpTool"
            VALUE "FileDescription",  "FTP Server Tool"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "FtpTool"
            VALUE "OriginalFilename", "FtpTool.exe"
            VALUE "ProductName",      "FTP Tool"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
